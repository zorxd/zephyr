/dts-v1/;
#include <microchip/pic32c/pic32cz_ca/pic32cz_ca70/pic32cz2051ca70144.dtsi>
#include "pic32cz_ca70_cult-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	compatible = "microchip,pic32cz_ca70_cult", "microchip,pic32cz2051ca70144";
	model = "PIC32CZ CA70 Curiosity Ultra";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		sw0 = &button0;
		sw1 = &button1;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&piod 23 GPIO_ACTIVE_LOW>;
			label = "USER LED0";
		};

		led1: led_1 {
			gpios = <&piod 29 GPIO_ACTIVE_LOW>;
			label = "USER LED1";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&pioa 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "SW0";
			zephyr,code = <INPUT_KEY_0>;
		};

		button1: button_1 {
			gpios = <&pioa 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "SW1";
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&cpu0 {
	clock-frequency = <300000000>;
};

/* 12 MHz crystal Y300 on XIN/XOUT (PB9/PB8). */
&main_xtal {
	clock-frequency = <12000000>;
	status = "okay";
};

/* PLLA = 12 MHz * 25 = 300 MHz, processor clock 300 MHz, MCK 150 MHz. */
&pmc {
	microchip,plla-mul = <25>;
	microchip,plla-div = <1>;
	microchip,mck-prescaler = <1>;
	microchip,mck-divider = <2>;
};

&uart1 {
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
	status = "okay";
};

/* SST26VF032B (U601) on the QSPI lines, used as a single-line SPI flash. */
&qspi {
	pinctrl-0 = <&qspi_default>;
	pinctrl-names = "default";
	status = "okay";

	qspi_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		size = <DT_SIZE_M(32)>;
		jedec-id = [bf 26 42];
		/*
		 * Basic Flash Parameters read from the device, with only the
		 * 4 KiB sector erase: block erase (D8h) erases 8, 32 or 64 KiB
		 * depending on the address, which the driver cannot handle.
		 */
		sfdp-bfp = [fd 20 f1 ff ff ff ff 01 44 eb 08 6b 08 3b 80 bb
			    fe ff ff ff ff ff 00 ff ff ff 44 0b 0c 20 00 00
			    00 00 00 00 20 91 48 24 80 6f 1d 81 ed 0f 77 38
			    30 b0 30 b0 f7 ff ff ff 29 c2 5c ff f0 30 c0 80];
		requires-ulbpr;
		use-fast-read;
		wp-gpios = <&pioa 17 GPIO_ACTIVE_LOW>;
		hold-gpios = <&piod 31 GPIO_ACTIVE_LOW>;
	};
};
