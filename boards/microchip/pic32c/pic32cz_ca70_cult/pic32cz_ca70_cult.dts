/dts-v1/;
#include <microchip/pic32c/pic32cz_ca/pic32cz_ca70/pic32cz2051ca70144.dtsi>
#include "pic32cz_ca70_cult-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	compatible = "microchip,pic32cz_ca70_cult", "microchip,pic32cz2051ca70144";
	model = "PIC32CZ CA70 Curiosity Ultra";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &eefc;
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
		zephyr,entropy = &trng;
		zephyr,canbus = &can0;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		sw0 = &button0;
		sw1 = &button1;
		i2c-0 = &twihs0;
		eeprom-0 = &eeprom;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&piod 23 GPIO_ACTIVE_LOW>;
			label = "USER LED0";
		};

		led1: led_1 {
			gpios = <&piod 29 GPIO_ACTIVE_LOW>;
			label = "USER LED1";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&pioa 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "SW0";
			zephyr,code = <INPUT_KEY_0>;
		};

		button1: button_1 {
			gpios = <&pioa 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "SW1";
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		/* 64 KB for storage partition, at the end of the flash */
		storage_partition: partition@1f0000 {
			compatible = "zephyr,mapped-partition";
			reg = <0x001f0000 DT_SIZE_K(64)>;
			label = "storage";
		};
	};
};

&cpu0 {
	clock-frequency = <300000000>;
};

/* 12 MHz crystal Y300 on XIN/XOUT (PB9/PB8). */
&main_xtal {
	clock-frequency = <12000000>;
	status = "okay";
};

/* PLLA = 12 MHz * 25 = 300 MHz, processor clock 300 MHz, MCK 150 MHz. */
&pmc {
	microchip,plla-mul = <25>;
	microchip,plla-div = <1>;
	microchip,mck-prescaler = <1>;
	microchip,mck-divider = <2>;
};

&uart1 {
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
	status = "okay";
};

&twihs0 {
	pinctrl-0 = <&twihs0_default>;
	pinctrl-names = "default";
	status = "okay";

	/* AT24MAC402 (U600), A2 A1 A0 = 1 1 0 (jumper J603 sets A0). */
	eeprom: eeprom@56 {
		compatible = "atmel,24mac402", "atmel,at24";
		reg = <0x56>;
		size = <256>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;
	};

	/* Factory programmed serial number and EUI-48 of the AT24MAC402. */
	eeprom_mac: eeprom@5e {
		compatible = "atmel,24mac402", "atmel,at24";
		reg = <0x5e>;
		size = <256>;
		pagesize = <16>;
		address-width = <8>;
		timeout = <5>;
		read-only;

		nvmem-layout {
			compatible = "fixed-layout";
			#address-cells = <1>;
			#size-cells = <1>;

			mac_address: mac-address@9a {
				reg = <0x9a 6>;
				#nvmem-cell-cells = <0>;
			};
		};
	};
};

/* RMII PHY daughter board (for example LAN8720A) on header J700/J701. */
&gmac {
	pinctrl-0 = <&gmac_rmii>;
	pinctrl-names = "default";
	nvmem-cells = <&mac_address>;
	nvmem-cell-names = "mac-address";
	phy-handle = <&phy>;
	status = "okay";
};

&mdio {
	pinctrl-0 = <&mdio_default>;
	pinctrl-names = "default";
	status = "okay";

	phy: ethernet-phy@0 {
		compatible = "ethernet-phy";
		reg = <0>;
		status = "okay";
	};
};

&trng {
	status = "okay";
};

&wdt {
	status = "okay";
};

/* The ATA6561 standby inputs are tied low: the transceivers are always active. */
&can0 {
	pinctrl-0 = <&can0_default>;
	pinctrl-names = "default";
	status = "okay";

	can-transceiver {
		max-bitrate = <5000000>;
	};
};

&can1 {
	pinctrl-0 = <&can1_default>;
	pinctrl-names = "default";
	status = "okay";

	can-transceiver {
		max-bitrate = <5000000>;
	};
};
