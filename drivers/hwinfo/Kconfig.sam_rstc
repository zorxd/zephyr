config HWINFO_SAM_RSTC
	bool "Atmel SAM reset cause"
	default y
	depends on (SOC_FAMILY_ATMEL_SAM && !SOC_SERIES_SAM4L) || SOC_SERIES_PIC32CZ_CA70
	select HWINFO_HAS_DRIVER
	help
	  Enable Atmel SAM reset cause hwinfo driver.
